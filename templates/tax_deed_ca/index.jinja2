<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Tax Deed - California</title>
    <style>
        /* ==========================================================================
           TAX DEED — CALIFORNIA (G3 rebuild, G2 chassis)

           Reference geometry: open recorder's space top-right (Gov C
           §27361.6), zero chrome on recorded pages (Gov C §27361.7). The
           §11922 exemption recital, tax-sale recitals, provisions, official
           execution and attestation are preserved verbatim (de-boxed to
           plain text; the official-seal placement box remains — it marks
           where a physical seal goes, like the notary seal box).
           ========================================================================== */

        @page { size: letter; margin: 0.5in 0.5in 0.6in 0.6in; }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: "Times New Roman", Times, Georgia, serif; font-size: 11pt; line-height: 1.35; color: #000; background: #fff; }

        .header-section { display: flex; min-height: 1.85in; }
        .recording-info { width: 3.4in; flex-shrink: 0; border-right: 0.75pt solid #000; padding-right: 0.15in; font-size: 10pt; line-height: 1.35; }
        .recorder-space { flex-grow: 1; }
        .recording-label { font-weight: bold; text-transform: uppercase; font-size: 9pt; }
        .recording-value { margin-bottom: 0.12in; min-height: 0.35in; }
        .ref-line { font-size: 10pt; }
        .header-boundary { display: flex; justify-content: space-between; align-items: baseline; border-bottom: 0.75pt solid #000; padding-bottom: 0.03in; margin-bottom: 0.12in; }
        .apn-ref { font-size: 10pt; }
        .recorder-caption { font-size: 7.5pt; font-weight: bold; text-transform: uppercase; }

        .deed-title { text-align: center; font-size: 14pt; font-weight: bold; letter-spacing: 2px; text-transform: uppercase; margin: 0.08in 0 0.12in 0; }

        .exemption-notice { font-size: 10pt; line-height: 1.5; margin-bottom: 0.12in; }
        .exemption-header { font-weight: bold; text-transform: uppercase; }

        .tax-sale-info { font-size: 10pt; line-height: 1.5; margin-bottom: 0.12in; }
        .tax-sale-header { font-weight: bold; text-transform: uppercase; }
        .tax-sale-row { margin-left: 0.15in; }

        .deed-body { font-size: 11pt; line-height: 1.45; }
        .deed-body p { margin-bottom: 0.08in; }
        .party-name { font-weight: bold; text-transform: uppercase; }
        /* D1: description weighted like the parties. */
        .legal-content { font-weight: bold; white-space: pre-wrap; margin: 0.08in 0; }
        .legal-exhibit-ref { font-weight: bold; margin: 0.08in 0; }
        .apn-line { margin-top: 0.08in; }

        .provisions-section { font-size: 10pt; line-height: 1.45; margin: 0.12in 0; }
        .provisions-header { font-weight: bold; text-transform: uppercase; }
        .provision-item { margin: 0.04in 0 0.04in 0.15in; }

        .execution-section { margin-top: 0.2in; page-break-inside: avoid; }
        .execution-date { margin-bottom: 0.15in; }
        .date-value { border-bottom: 0.75pt solid #000; min-width: 1.8in; display: inline-block; text-align: center; }
        .official-title { font-weight: bold; }
        .signature-entry { margin-top: 0.3in; width: 3.4in; }
        .signature-line { border-bottom: 0.75pt solid #000; width: 3.4in; height: 0.35in; }
        .signature-name { font-size: 10pt; text-transform: uppercase; }
        .signature-title { font-size: 10pt; }

        .attestation-section { margin-top: 0.25in; page-break-inside: avoid; display: flex; justify-content: space-between; gap: 0.3in; align-items: flex-start; }
        .attestation-text { font-size: 10pt; line-height: 1.45; }
        .attestation-header { font-weight: bold; text-transform: uppercase; }
        .seal-area { border: 0.75pt solid #000; width: 2in; height: 2in; flex-shrink: 0; display: flex; align-items: center; justify-content: center; text-align: center; }
        .seal-label { font-size: 9pt; font-weight: bold; text-transform: uppercase; }

        .mail-tax-directive { text-align: center; font-size: 9pt; font-weight: bold; text-transform: uppercase; margin-top: 0.3in; }

        .page-break { page-break-before: always; }
        .exhibit-page { padding-top: 0.5in; }
        .exhibit-header { text-align: center; margin-bottom: 0.4in; }
        .exhibit-title { font-size: 14pt; font-weight: bold; text-transform: uppercase; letter-spacing: 2px; }
        .exhibit-subtitle { font-size: 11pt; margin-top: 0.08in; }
        .exhibit-content { font-size: 11pt; line-height: 1.5; text-align: justify; white-space: pre-wrap; }
        .exhibit-apn { margin-top: 0.3in; font-size: 10pt; }
    </style>
</head>
<body>
    <div class="deed-page">

        <header class="header-section">
            <div class="recording-info">
                <div class="recording-label">Recording Requested By:</div>
                <div class="recording-value">{{ requested_by or title_company or '' }}</div>

                <div class="recording-label">Mail Tax Statements and<br>When Recorded Mail To:</div>
                <div class="recording-value">
                    {% if return_to %}
                        {% if return_to.get('name') %}{{ return_to.get('name') }}<br>{% endif %}
                        {% if return_to.get('company') %}{{ return_to.get('company') }}<br>{% endif %}
                        {% if return_to.get('address1') %}{{ return_to.get('address1') }}<br>{% endif %}
                        {% if return_to.get('address2') %}{{ return_to.get('address2') }}<br>{% endif %}
                        {% set city = return_to.get('city', '') %}
                        {% set state = return_to.get('state', '') %}
                        {% set zip = return_to.get('zip', '') %}
                        {% if city or state or zip %}
                            {{ city }}{% if city and (state or zip) %}, {% endif %}{{ state }} {{ zip }}
                        {% endif %}
                    {% else %}
                        _________________________________<br>
                        _________________________________<br>
                        _________________________________
                    {% endif %}
                </div>

                <div class="ref-line">Order No.: {{ title_order_no or '____________________' }}</div>
                <div class="ref-line">Tax Sale No.: {{ tax_sale_ref or '____________________' }}</div>
            </div>

            <div class="recorder-space"><!-- Gov. Code §27361.6 — recorder's use only --></div>
        </header>

        <div class="header-boundary">
            <span class="apn-ref">APN: {{ apn or '____________________' }}</span>
            <span class="recorder-caption">Space Above This Line Is For Recorder&rsquo;s Use</span>
        </div>

        <h1 class="deed-title">Tax Deed</h1>

        <div class="exemption-notice">
            <span class="exemption-header">Documentary Transfer Tax: Exempt.</span>
            This deed is exempt from Documentary Transfer Tax pursuant to California Revenue
            and Taxation Code Section 11922 (conveyance by operation of law).
        </div>

        <div class="tax-sale-info">
            <div class="tax-sale-header">Tax Sale Information</div>
            <div class="tax-sale-row">Tax Sale Reference: {{ tax_sale_ref or '____________________' }}</div>
            <div class="tax-sale-row">Sale Date: {{ tax_sale_date or '____________________' }}</div>
            <div class="tax-sale-row">Purchase Price: ${{ tax_sale_amount or '____________________' }}</div>
            <div class="tax-sale-row">Tax Years Delinquent: {{ tax_years_delinquent or '____________________' }}</div>
        </div>

        <div class="deed-body">
            <p>WHEREAS, the real property hereinafter described was duly sold by the Tax Collector of the County of <strong>{{ county or '___________________________' }}</strong>, State of California, for nonpayment of delinquent taxes; and</p>
            <p>WHEREAS, all statutory requirements for such tax sale have been duly complied with, and the period of redemption has expired;</p>
            <p>NOW, THEREFORE, the undersigned Tax Collector, by virtue of the authority vested by law, does hereby grant, bargain, sell and convey to:</p>

            <p><span class="party-name">{{ grantees_text or '_________________________________________________' }}</span> (&ldquo;Grantee/Purchaser&rdquo;)</p>

            <p>all right, title, interest and claim of the State of California, the County of {{ county or '___________________________' }}, and all taxing agencies, in and to the following described real property:</p>

            {% if legal_description and legal_description|length > (exhibit_threshold or 600) %}
                <p class="legal-exhibit-ref">
                    See Exhibit &ldquo;A&rdquo; attached hereto and incorporated herein by this reference.
                </p>
            {% else %}
                <div class="legal-content">{{ legal_description or 'LEGAL DESCRIPTION TO BE INSERTED' }}</div>
            {% endif %}

            {% if apn %}
            <div class="apn-line">Assessor&rsquo;s Parcel Number: {{ apn }}</div>
            {% endif %}
        </div>

        <div class="provisions-section">
            <div class="provisions-header">Tax Deed Provisions</div>
            <div class="provision-item">1. This conveyance is made pursuant to Division 1, Part 6, Chapter 7 and Chapter 8 of the California Revenue and Taxation Code.</div>
            <div class="provision-item">2. The property is conveyed subject to any liens for special assessments or other charges not included in the tax sale.</div>
            <div class="provision-item">3. This deed conveys only the interest acquired by the taxing agencies through the tax sale process.</div>
            <div class="provision-item">4. The grantee takes title subject to any rights of redemption that may still exist under applicable law.</div>
        </div>

        <div class="execution-section">
            <div class="execution-date">
                Dated: <span class="date-value">{{ execution_date or now().strftime('%B %d, %Y') }}</span>
            </div>

            <div class="official-title">COUNTY OF {{ (county or '_______________')|upper }}</div>

            <div class="signature-entry">
                <div class="signature-line"></div>
                <div class="signature-name">{{ tax_collector_name or '' }}</div>
                <div class="signature-title">Tax Collector</div>
            </div>
            <div class="signature-entry">
                <div class="signature-line"></div>
                <div class="signature-name">{{ deputy_name or '' }}</div>
                <div class="signature-title">Deputy Tax Collector</div>
            </div>
        </div>

        <div class="attestation-section">
            <div class="attestation-text">
                <div class="attestation-header">Attestation</div>
                I, the undersigned Tax Collector of the County of {{ county or '_______________' }}, State of California,
                do hereby certify that the foregoing Tax Deed was executed pursuant to due authority of law,
                and that all proceedings required by law preliminary to the issuance of this deed have been
                regularly had and taken.
            </div>
            <div class="seal-area">
                <span class="seal-label">Official Seal of<br>Tax Collector<br>{{ county or '' }} County</span>
            </div>
        </div>

        <div class="mail-tax-directive">Mail Tax Statements As Directed Above</div>

    </div>

    {% if legal_description and legal_description|length > (exhibit_threshold or 600) %}
    <div class="page-break"></div>
    <div class="exhibit-page">
        <div class="exhibit-header">
            <div class="exhibit-title">Exhibit &ldquo;A&rdquo;</div>
            <div class="exhibit-subtitle">Legal Description</div>
        </div>
        <div class="exhibit-content">{{ legal_description }}</div>
        {% if apn %}
        <div class="exhibit-apn">Assessor&rsquo;s Parcel Number: {{ apn }}</div>
        {% endif %}
    </div>
    {% endif %}

    {# Tax deeds are government-issued and use the attestation above; the
       §1189 acknowledgment page is included for optional use if needed. #}
    {% set document_title = 'Tax Deed' %}
    {% include '_partials/notary_acknowledgment.jinja2' %}

</body>
</html>
